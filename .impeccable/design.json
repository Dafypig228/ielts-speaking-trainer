  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action: Next, Save & next, Start.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Save &amp; next <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{min-height:44px;border:1px solid var(--line-strong);background:var(--surface);color:var(--ink);border-radius:8px;padding:9px 15px;font:600 15px Onest,\"Segoe UI\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;cursor:pointer;transition:background .12s,border-color .12s}.ds-btn-primary{background:var(--act);border-color:var(--act);color:var(--on-act)}.ds-btn-primary:hover{background:color-mix(in oklab,var(--act) 88%,var(--ink))}.ds-btn:focus-visible{outline:2px solid var(--act);outline-offset:2px}.ds-btn:active{transform:translateY(1px)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tools under the question: Read aloud, Star, Ideas.",
      "html": "<button class=\"ds-btn2\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"><path d=\"M12 3l2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z\"/></svg>Star</button> <button class=\"ds-btn2 ds-on\">Starred</button>",
      "css": ".ds-btn2{min-height:44px;border:1px solid var(--line-strong);background:var(--surface);color:var(--ink);border-radius:8px;padding:9px 15px;font:600 15px Onest,\"Segoe UI\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;cursor:pointer;transition:background .12s}.ds-btn2:hover{background:var(--sunken)}.ds-btn2:focus-visible{outline:2px solid var(--act);outline-offset:2px}.ds-btn2:active{transform:translateY(1px)}.ds-btn2.ds-on{background:var(--signal-soft);border-color:color-mix(in oklab,var(--signal) 60%,var(--line));color:var(--signal-ink)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Search, notes, settings fields.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Notes: keywords for each bullet\">",
      "css": ".ds-input{background:var(--surface);border:1px solid var(--line-strong);border-radius:8px;padding:10px 12px;min-height:44px;width:100%;font:16px Onest,\"Segoe UI\",system-ui,sans-serif;color:var(--ink)}.ds-input::placeholder{color:var(--muted)}.ds-input:focus{outline:none;border-color:var(--act);box-shadow:0 0 0 3px color-mix(in oklab,var(--act) 22%,transparent)}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "segment-pressed",
      "description": "Phone bottom tabs on board blue; current tab carries the amber bar.",
      "html": "<nav class=\"ds-tabs\"><a aria-current=\"page\" href=\"#\">Practise</a><a href=\"#\">Takes</a><a href=\"#\">Vocabulary</a><a href=\"#\">Settings</a></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(4,1fr);height:60px;background:var(--board);font:500 12px Onest,\"Segoe UI\",system-ui,sans-serif}.ds-tabs a{position:relative;display:flex;align-items:center;justify-content:center;color:var(--on-board-muted);text-decoration:none}.ds-tabs a:hover{color:var(--on-board)}.ds-tabs a:focus-visible{outline:2px solid var(--signal);outline-offset:-4px}.ds-tabs a[aria-current=page]{color:var(--on-board);font-weight:650}.ds-tabs a[aria-current=page]::before{content:\"\";position:absolute;top:0;left:22%;right:22%;height:3px;background:var(--signal);border-radius:0 0 3px 3px}"
    },
    {
      "name": "Departure Board",
      "kind": "custom",
      "refersTo": "departure-row",
      "description": "Home timetable: duration, mode, what is left.",
      "html": "<div class=\"ds-board\"><div class=\"ds-bh\"><span>Time</span><span>Practice</span><span>Status</span><span></span></div><a class=\"ds-dep\" href=\"#\"><span class=\"ds-time\">10<small>min</small></span><span><b class=\"ds-name\">Weak spots</b><span class=\"ds-what\">Low scores first.</span></span><span class=\"ds-left\"><b>6</b><small>to redo</small></span><span class=\"ds-go\">&rarr;</span></a><a class=\"ds-dep\" href=\"#\"><span class=\"ds-time\">5<small>min</small></span><span><b class=\"ds-name\">Vocabulary</b><span class=\"ds-what\">Phrases to review.</span></span><span class=\"ds-left\"><b class=\"ds-now\">2</b><small>phrases due</small></span><span class=\"ds-go\">&rarr;</span></a></div>",
      "css": ".ds-board{background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden;font-family:Onest,\"Segoe UI\",system-ui,sans-serif;color:var(--ink)}.ds-bh,.ds-dep{display:grid;grid-template-columns:64px minmax(0,1fr) auto 18px;gap:0 14px;align-items:center}.ds-bh{padding:8px 16px;background:var(--board);color:var(--on-board-muted);font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}.ds-bh span:nth-child(3){text-align:right}.ds-dep{padding:14px 16px;min-height:84px;border-top:1px solid var(--line);color:inherit;text-decoration:none}.ds-bh+.ds-dep{border-top:0}.ds-dep:hover{background:var(--sunken)}.ds-dep:hover .ds-go{color:var(--ink);transform:translateX(2px)}.ds-dep:focus-visible{outline:2px solid var(--act);outline-offset:-2px}.ds-time{font-weight:700;font-size:32px;line-height:1;letter-spacing:-.04em}.ds-time small{display:block;letter-spacing:0;font-size:12.5px;font-weight:500;color:var(--muted);margin-top:4px}.ds-name{display:block;font-size:18px;font-weight:650}.ds-what{display:block;font-size:14px;color:var(--muted)}.ds-left{text-align:right}.ds-left b{display:block;font-size:24px;font-weight:700;line-height:1}.ds-left b.ds-now{color:var(--signal-ink)}.ds-left small{font-size:12.5px;color:var(--muted)}.ds-go{color:var(--line-strong);transition:transform .15s,color .15s}"
    },
    {
      "name": "Part Badges",
      "kind": "chip",
      "refersTo": "part-badge-1",
      "description": "Square route-number badges for Parts 1, 2, 3.",
      "html": "<span class=\"ds-pill\"><b>1</b>Part 1</span> <span class=\"ds-pill ds-p2\"><b>2</b>Part 2</span> <span class=\"ds-pill ds-p3\"><b>3</b>Part 3</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;font:600 13px Onest,\"Segoe UI\",system-ui,sans-serif;color:var(--muted)}.ds-pill b{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:5px;background:var(--p1);color:var(--on-part);font-weight:700;font-size:15px;line-height:1}.ds-p2 b{background:var(--p2)}.ds-p3 b{background:var(--p3)}"
    },
    {
      "name": "Band Chips",
      "kind": "chip",
      "refersTo": "band-mid",
      "description": "Band estimates: low ochre, mid neutral, high green.",
      "html": "<span class=\"ds-band ds-lo\">5.5</span> <span class=\"ds-band\">6.5</span> <span class=\"ds-band ds-hi\">7.5</span>",
      "css": ".ds-band{display:inline-flex;align-items:center;justify-content:center;min-width:42px;height:28px;padding:0 8px;border-radius:6px;font:700 17px Onest,\"Segoe UI\",system-ui,sans-serif;background:var(--sunken);color:var(--ink)}.ds-lo{background:var(--warn-soft);color:var(--warn)}.ds-hi{background:var(--ok-soft);color:var(--ok)}"
    },
    {
      "name": "Record Dock",
      "kind": "custom",
      "refersTo": "record-dock-live",
      "description": "Thumb-zone record control; turns red-tinted only while live.",
      "html": "<div class=\"ds-dock ds-live\"><button class=\"ds-rec\" aria-label=\"Stop\"><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\" fill=\"currentColor\"/></svg></button><div class=\"ds-dt\"><span>0:42</span><small>of 2:00</small></div></div>",
      "css": ".ds-dock{display:flex;align-items:center;gap:14px;padding:10px 16px;min-height:88px;background:var(--surface);border-top:1px solid var(--line);box-shadow:0 -6px 18px color-mix(in oklab,var(--ink) 7%,transparent);font-family:Onest,\"Segoe UI\",system-ui,sans-serif;color:var(--ink)}.ds-dock.ds-live{background:var(--rec-soft);border-top-color:var(--rec)}.ds-rec{width:64px;height:64px;border-radius:50%;border:0;background:var(--rec);color:var(--on-rec);display:grid;place-items:center;cursor:pointer;box-shadow:0 4px 14px color-mix(in oklab,var(--rec) 30%,transparent)}.ds-live .ds-rec{animation:ds-pulse 1.4s ease-in-out infinite}.ds-rec:focus-visible{outline:2px solid var(--act);outline-offset:2px}@keyframes ds-pulse{50%{box-shadow:0 0 0 9px color-mix(in oklab,var(--rec) 20%,transparent)}}.ds-dt{display:flex;flex-direction:column}.ds-dt span{font-weight:700;font-size:28px;line-height:1;font-variant-numeric:tabular-nums}.ds-dt small{font-size:13px;color:var(--muted)}"
    }
  ],
  "narrative": {
    "northStar": "The Station Board",
    "overview": "**Creative North Star: \"The Station Board\"**\n\nThe app reads like the departure hall of a Kazakh railway station. A deep board-blue band runs across the top and, on phones, across the bottom; between them is a cool near-white floor of ruled rows. The home screen is a timetable: each practice mode is a departure, its duration sits in the time column, and what is left for it sits in the status column. Exam day is the one fixed departure in the header, counted down in bold numerals.\n\nDensity is moderate and practical: rows are tall enough to hit with a thumb (56 to 84px), type is one family at a small number of weights, and colour is spent only where it carries information. Blue means the board and the action. Amber means now or next. Red means the microphone. Teal, orange and violet are the three lines (Parts 1, 2, 3). Everything else is ink on paper.\n\nProgress is shown as plain facts and counts, never as rewards: there are no rings, streak flames, trophies, confetti or celebratory colour anywhere in the build.",
    "keyCharacteristics": [
      "Board-blue header and tab bar framing a cool near-white ground.",
      "One typeface, Onest, with bold numerals for every time, duration and countdown.",
      "Rows divided by 1px rules inside lightly bordered containers; depth is mostly flat.",
      "Amber kept for now/next, red kept for recording, part line colours kept for part identity.",
      "Full light and dark themes from the same OKLCH token set, hue 262 for every neutral."
    ],
    "rules": [
      {
        "name": "The Now-and-Next Rule",
        "body": "Amber marks only what is current or due: days left, the selected tab, the current mock stop, phrases due today. A count of zero or a past item is never amber.",
        "section": "colors"
      },
      {
        "name": "The Live Red Rule",
        "body": "The record button is red at rest by convention. The 3px red line under the header and the red-tinted dock appear only while a recording is live, and go away when it stops.",
        "section": "colors"
      },
      {
        "name": "The Line Colour Rule",
        "body": "Teal, orange and violet identify Parts 1, 2 and 3 and nothing else: badges, mock-test stops, coverage meters.",
        "section": "colors"
      },
      {
        "name": "The Bold Numeral Rule",
        "body": "Times, durations, counts and countdowns are Onest 700. Digits are proportional everywhere except timers that tick (record, dock, prep, mock clock), which use tabular figures so they do not jitter.",
        "section": "typography"
      },
      {
        "name": "The Station Header Rule",
        "body": "Uppercase tracked text is the board's column header and nowhere else.",
        "section": "typography"
      },
      {
        "name": "The Ruled Rows Rule",
        "body": "Rows are divided by 1px rules, not by gaps between floating cards. A new surface earns a shadow only if it sits above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set every time, duration and countdown in Onest 700, tabular only when it ticks.",
      "**Do** keep amber for now/next: days left, current tab, current mock stop, phrases due.",
      "**Do** keep the record button red at rest and switch the header line and dock to red only while live.",
      "**Do** mark Parts 1, 2, 3 with teal, orange and violet square numeral badges and matching mock stops.",
      "**Do** divide rows with 1px rules inside one bordered container; keep controls at 44px or taller.",
      "**Do** take every colour from the OKLCH tokens so light and dark themes both hold."
    ],
    "donts": [
      "**Don't** add game mechanics or their visuals: streaks, badges, goal rings, confetti, celebratory colour.",
      "**Don't** use amber for decoration, emphasis, warnings or zero counts.",
      "**Don't** use red anywhere but recording, pause marks and destructive actions.",
      "**Don't** reuse the part line colours for anything other than part identity.",
      "**Don't** add uppercase tracked labels outside the departure board's column header.",
      "**Don't** put shadows on cards or rows; shadows belong to the sheet, modal, toast, dock and record button.",
      "**Don't** add a second typeface."
    ]
  }
}